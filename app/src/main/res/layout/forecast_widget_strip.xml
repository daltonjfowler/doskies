<?xml version="1.0" encoding="utf-8"?>
<!--
  PLACEHOLDER ART (T2). Plain standard views only, not the DOS/pixel look T5 will draw.
  Stable ids (card, current_temp, current_cond, refresh) are the seam that pass reads
  from; keep them if the visuals get replaced.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/card"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp"
    android:background="@drawable/widget_bg">

    <TextView android:id="@+id/current_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="--" android:textSize="16sp" android:textStyle="bold" android:textColor="#EFF5EE"
        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />

    <TextView android:id="@+id/current_cond" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:text="Waiting" android:textSize="11sp" android:textColor="#ADBBB2"
        android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" />

    <TextView android:id="@+id/refresh" android:layout_width="32dp" android:layout_height="32dp"
        android:gravity="center" android:text="&#8635;" android:textSize="16sp" android:textColor="#FFBA7A"
        android:contentDescription="Refresh forecast" />
</LinearLayout>
