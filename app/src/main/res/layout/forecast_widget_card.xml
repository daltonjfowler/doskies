<?xml version="1.0" encoding="utf-8"?>
<!--
  PLACEHOLDER ART (T2). Plain standard views only (LinearLayout/TextView), not the DOS/pixel
  look T5 will draw. Stable ids (card, title, current_temp, current_cond, refresh,
  day_0..day_6 each with *_dow/*_hi/*_lo/*_precip, freshness) are the seam that pass reads
  from. Keep them if the visuals get replaced; the day rows default to gone and ForecastWidget
  turns them on for the LARGE variant only.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/card"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="10dp" android:background="@drawable/widget_bg">

    <LinearLayout android:id="@+id/title_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="DOSkies" android:textSize="10sp" android:letterSpacing="0.12" android:textStyle="bold"
            android:textColor="#FFBA7A" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/refresh" android:layout_width="32dp" android:layout_height="32dp"
            android:gravity="center" android:text="&#8635;" android:textSize="16sp" android:textColor="#FFBA7A"
            android:contentDescription="Refresh forecast" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <TextView android:id="@+id/current_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--" android:textSize="26sp" android:textStyle="bold" android:textColor="#EFF5EE"
            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/current_cond" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="Waiting" android:textSize="12sp" android:textColor="#ADBBB2"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout android:id="@+id/days_table" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="6dp">

        <LinearLayout android:id="@+id/day_0" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="1dp" android:visibility="gone">
            <TextView android:id="@+id/day_0_dow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Day" android:textSize="11sp" android:textColor="#D5DED8" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_0_hi" android:layout_width="32dp" android:layout_height="wrap_content"
                android:text="--&#176;" android:textSize="11sp" android:textColor="#EFF5EE" android:gravity="end" />
            <TextView android:id="@+id/day_0_lo" android:layout_width="32dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="--&#176;" android:textSize="11sp" android:textColor="#8E9B94" android:gravity="end" />
            <TextView android:id="@+id/day_0_precip" android:layout_width="36dp" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="--%" android:textSize="11sp" android:textColor="#7FB6FF" android:gravity="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/day_1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="1dp" android:visibility="gone">
            <TextView android:id="@+id/day_1_dow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Day" android:textSize="11sp" android:textColor="#D5DED8" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_1_hi" android:layout_width="32dp" android:layout_height="wrap_content"
                android:text="--&#176;" android:textSize="11sp" android:textColor="#EFF5EE" android:gravity="end" />
            <TextView android:id="@+id/day_1_lo" android:layout_width="32dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="--&#176;" android:textSize="11sp" android:textColor="#8E9B94" android:gravity="end" />
            <TextView android:id="@+id/day_1_precip" android:layout_width="36dp" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="--%" android:textSize="11sp" android:textColor="#7FB6FF" android:gravity="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/day_2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="1dp" android:visibility="gone">
            <TextView android:id="@+id/day_2_dow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Day" android:textSize="11sp" android:textColor="#D5DED8" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_2_hi" android:layout_width="32dp" android:layout_height="wrap_content"
                android:text="--&#176;" android:textSize="11sp" android:textColor="#EFF5EE" android:gravity="end" />
            <TextView android:id="@+id/day_2_lo" android:layout_width="32dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="--&#176;" android:textSize="11sp" android:textColor="#8E9B94" android:gravity="end" />
            <TextView android:id="@+id/day_2_precip" android:layout_width="36dp" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="--%" android:textSize="11sp" android:textColor="#7FB6FF" android:gravity="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/day_3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="1dp" android:visibility="gone">
            <TextView android:id="@+id/day_3_dow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Day" android:textSize="11sp" android:textColor="#D5DED8" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_3_hi" android:layout_width="32dp" android:layout_height="wrap_content"
                android:text="--&#176;" android:textSize="11sp" android:textColor="#EFF5EE" android:gravity="end" />
            <TextView android:id="@+id/day_3_lo" android:layout_width="32dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="--&#176;" android:textSize="11sp" android:textColor="#8E9B94" android:gravity="end" />
            <TextView android:id="@+id/day_3_precip" android:layout_width="36dp" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="--%" android:textSize="11sp" android:textColor="#7FB6FF" android:gravity="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/day_4" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="1dp" android:visibility="gone">
            <TextView android:id="@+id/day_4_dow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Day" android:textSize="11sp" android:textColor="#D5DED8" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_4_hi" android:layout_width="32dp" android:layout_height="wrap_content"
                android:text="--&#176;" android:textSize="11sp" android:textColor="#EFF5EE" android:gravity="end" />
            <TextView android:id="@+id/day_4_lo" android:layout_width="32dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="--&#176;" android:textSize="11sp" android:textColor="#8E9B94" android:gravity="end" />
            <TextView android:id="@+id/day_4_precip" android:layout_width="36dp" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="--%" android:textSize="11sp" android:textColor="#7FB6FF" android:gravity="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/day_5" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="1dp" android:visibility="gone">
            <TextView android:id="@+id/day_5_dow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Day" android:textSize="11sp" android:textColor="#D5DED8" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_5_hi" android:layout_width="32dp" android:layout_height="wrap_content"
                android:text="--&#176;" android:textSize="11sp" android:textColor="#EFF5EE" android:gravity="end" />
            <TextView android:id="@+id/day_5_lo" android:layout_width="32dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="--&#176;" android:textSize="11sp" android:textColor="#8E9B94" android:gravity="end" />
            <TextView android:id="@+id/day_5_precip" android:layout_width="36dp" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="--%" android:textSize="11sp" android:textColor="#7FB6FF" android:gravity="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/day_6" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="1dp" android:visibility="gone">
            <TextView android:id="@+id/day_6_dow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Day" android:textSize="11sp" android:textColor="#D5DED8" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_6_hi" android:layout_width="32dp" android:layout_height="wrap_content"
                android:text="--&#176;" android:textSize="11sp" android:textColor="#EFF5EE" android:gravity="end" />
            <TextView android:id="@+id/day_6_lo" android:layout_width="32dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="--&#176;" android:textSize="11sp" android:textColor="#8E9B94" android:gravity="end" />
            <TextView android:id="@+id/day_6_precip" android:layout_width="36dp" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="--%" android:textSize="11sp" android:textColor="#7FB6FF" android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <TextView android:id="@+id/freshness" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Waiting" android:textSize="10sp" android:textColor="#8E9B94"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
